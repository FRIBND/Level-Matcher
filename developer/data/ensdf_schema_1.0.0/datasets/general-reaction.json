{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "general-reaction.json",
	"description": "A general-purpose dataset type for experiments populating a nuclear via a reaction.  A typical use-case for this validator would be for heavy-ion fusion-evaporation datasets (often given a name like '(HI,xng)').  More specific types of reactions, such as nuclear-resonance fluorescence or transfer, should use their respective validators.",
	"type": "object",
	"required": [ "header"],
	"anyOf": [
		{ "required": [ "levelsTable" ] },
		{ "required": [ "gammasTable" ] }
	],
	"additionalProperties": false,
	"properties": {
		"header": {
			"type": "object",
			"$ref": "evaluation-header.json",
			"properties": {
				"documentType": {
					"const": "generalReaction"
				},
				"database": {
					"enum": [ "ENSDF", "XUNDL" ]
				},
				"schemaVersion": {
					"type": "string",
					"const": "1.0.0"
				}
			},
			"if": {
				"properties": {
					"database": {
						"const": "XUNDL"
					}
				}
			},
			"then": {
				"not": {
					"type": "object",
					"required": [ "history" ]
				}
			},
			"else": {
				"type": "object",
				"required": [ "history" ]
			}
		},
		"comments": {
			"$ref": "basic-comments.json"
		},
		"tables": {
			"$ref": "unformatted-tables.json"
		},
		"references": {
			"$ref": "references.json"
		},
		"levelsTable": {
			"type": "object",
			"$ref": "levels-table.json",
			"unevaluatedProperties": false,
			"required": [ "levels" ],
			"properties": {
				"levels": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"unevaluatedProperties": false,
						"$ref": "level.json",
						"properties": {
							"angularMomentumTransfer": {
								"$ref": "angular-momentum-transfer.json"
							}
						}
					}
				},
				"comments": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"columns": {
								"type": "object",
								"propertyNames": {
									"enum": [
										"energy",
										"spinParity",
										"halfLife",
										"angularMomentumTransfer"
									]
								}
							}
						}
					}
				}
			}
		},
		"gammasTable": {
			"$ref": "gammas-table.json"
		}
	}
}
