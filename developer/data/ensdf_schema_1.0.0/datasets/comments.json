{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "comments.json",
	"description": "This schema describes datasets which contain only qualitative information.  It allows comments and references, but does not include tables for levels, gammas, or any other radiation type.  A typical use case would be an isotope-discovery experiment which reported a negative result.",
	"type": "object",
	"additionalProperties": false,
	"required": [ "header", "comments" ],
	"properties": {
		"header": {
			"type": "object",
			"$ref": "evaluation-header.json",
			"properties": {
				"documentType": {
					"const": "comments"
				},
				"database": {
					"enum": [ "ENSDF", "XUNDL" ]
				},
				"schemaVersion": {
					"type": "string",
					"const": "1.0.0"
				}
			},
			"if": {
				"properties": {
					"database": {
						"const": "XUNDL"
					}
				}
			},
			"then": {
				"not": {
					"type": "object",
					"required": [ "history" ]
				}
			},
			"else": {
				"type": "object",
				"required": [ "history" ]
			}
		},
		"comments": {
			"$ref": "basic-comments.json"
		},
		"tables": {
			"$ref": "unformatted-tables.json"
		},
		"references": {
			"$ref": "references.json"
		}
	}
}
