{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "proton-decay.json",
	"description": "This schema describes the format for datasets containing information on proton decay.  In addition to tables for levels and gammas, it contains a table of proton radiations.  Levels fed by proton decay contain a 'proton' property which contains the index of the proton in the protonsTable which feeds that state.",
    "type": "object",
	"required": [ "header", "parent", "decayMode" ],
	"anyOf": [
		{ "required": [ "levelsTable" ] },
		{ "required": [ "gammasTable" ] },
		{ "required": [ "protonsTable" ] }
	],
	"additionalProperties": false,
	"properties": {
		"header": {
			"type": "object",
			"$ref": "evaluation-header.json",
			"properties": {
				"documentType": {
					"const": "protonDecay"
				},
				"database": {
					"enum": [ "ENSDF", "XUNDL" ]
				},
				"schemaVersion": {
					"type": "string",
					"const": "1.0.0"
				}
			},
			"if": {
				"properties": {
					"database": {
						"const": "XUNDL"
					}
				}
			},
			"then": {
				"not": {
					"type": "object",
					"required": [ "history" ]
				}
			},
			"else": {
				"type": "object",
				"required": [ "history" ]
			}
		},
		"parent": {
			"type": "object",
			"$ref": "decay-parent.json",
			"required": [ "qValue" ]
		},
		"decayMode": {
			"$ref": "decay-modes.json#/properties/common",
			"const": "p"
		},
		"comments": {
			"$ref": "basic-comments.json"
		},
		"tables": {
			"$ref": "unformatted-tables.json"
		},
		"references": {
			"$ref": "references.json"
		},
		"levelsTable": {
			"type": "object",
			"unevaluatedProperties": false,
			"$ref": "levels-table.json",
			"required": [ "levels" ],
			"properties": {
				"levels": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"unevaluatedProperties": false,
						"$ref": "level.json",
						"properties": {
							"proton": {
								"type": "integer",
								"minimum": 0
							}
						}
					}
				},
				"comments": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"columns": {
								"type": "object",
								"propertyNames": {
									"enum": [
										"energy",
										"spinParity",
										"halfLife"
									]
								}
							}
						}
					}
				}
			}
		},
		"gammasTable": {
			"$ref": "gammas-table.json"
		},
		"protonsTable": {
			"$ref": "protons-table.json"
		}
	}
}
