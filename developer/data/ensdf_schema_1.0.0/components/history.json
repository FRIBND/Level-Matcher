{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "history.json",
	"type": "object",
	"description": "A record of the dataset, starting from its original publication and including all subsequent modifications.",
	"required": ["fullEvaluation"],
	"additionalProperties": false,
	"properties": {
		"fullEvaluation": {
			"type": "object",
			"description": "This is the record of the original publication of the evaluation and is required of all ENSDF documents.",
			"required": [ "authors", "publication", "cutoffDate" ],
			"additionalProperties": false,
			"properties": {
				"authors": {
					"$ref": "#/$defs/authors"
				},
				"publication": {
					"description": "This is typically a Nuclear Data Sheets reference, but could be Nuclear Physics A or simply 'ENSDF' if the evaluation wasn't formally published.",
					"type": "string"
				},
				"cutoffDate": {
					"$ref": "#/$defs/date-format"
				}
			}
		},
		"updates": {
			"description": "If a document needs to be modified after it is published, records of those modifications are stored here.  In essence, this is the changelog for the document.",
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [ "authors", "date" ],
				"properties": {
					"authors": {
						"$ref": "#/$defs/authors"
					},
					"date": {
						"$ref": "#/$defs/date-format"
					},
					"comment": {
						"type": "string"
					},
					"publication": {
						"type": "string"
					}
				}
			}
		}
	},
	"$defs": {
		"date-format": {
			"description": "ISO 8601-compliant date format, YYYY-MM-DD.",
			"type": "string",
			"pattern": "[0-9]{4}-[0-1]{1}[0-9]{1}-[0-3]{1}[0-9]{1}"
		},
		"authors": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["name"],
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"affiliations": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string"
						}
					},
					"orcid": {
						"type": "string",
						"pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}([0-9]|[X])$"
					}
				}
			}
		}
	}
}
