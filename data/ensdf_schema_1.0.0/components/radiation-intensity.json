{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "radiation-intensity.json",
	"description": "The intensity with which a radiation is emitted",
	"type": "object",
	"unevaluatedProperties": false,
	"allOf": [
		{
			"$ref": "quantity.json",
			"properties": {
				"comments": {
					"$ref": "basic-comments.json"
				}
			}
		},
		{
			"type": "object",
			"$ref": "measurements.json",
			"properties": {
				"measurements": {
					"type": "array",
					"items": {
						"type": "object",
						"unevaluatedProperties": false,
						"allOf": [
							{ "$ref": "measurement.json" },
							{ "$ref": "quantity.json" }
						]
					}
				}
			}
		}
	]
}
