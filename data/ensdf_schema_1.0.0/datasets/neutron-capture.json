{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "neutron-capture.json",
	"description": "This schema describes the format for neutron-capture datasets.  It is unique in that it is a reaction dataset that features a normalization factor; the normalization is used to convert the given gamma-ray intensities to gamma rays per 100 neutron captures.",
	"type": "object",
	"required": [ "header" ],
	"anyOf": [
		{ "required": [ "levelsTable" ] },
		{ "required": [ "gammasTable" ] }
	],
	"additionalProperties": false,
	"properties": {
		"header": {
			"type": "object",
			"$ref": "evaluation-header.json",
			"properties": {
				"documentType": {
					"const": "neutronCapture"
				},
				"database": {
					"enum": [ "ENSDF", "XUNDL" ]
				},
				"schemaVersion": {
					"type": "string",
					"const": "1.0.0"
				}
			},
			"if": {
				"properties": {
					"database": {
						"const": "XUNDL"
					}
				}
			},
			"then": {
				"not": {
					"type": "object",
					"required": [ "history" ]
				}
			},
			"else": {
				"type": "object",
				"required": [ "history" ]
			}
		},
		"comments": {
			"$ref": "basic-comments.json"
		},
		"tables": {
			"$ref": "unformatted-tables.json"
		},
		"references": {
			"$ref": "references.json"
		},
		"levelsTable": {
			"type": "object",
			"unevaluatedProperties": false,
			"$ref": "levels-table.json",
			"required": [ "levels" ],
			"properties": {
				"levels": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"unevaluatedProperties": false,
						"$ref": "level.json",
						"properties": {
							"angularMomentumTransfer": {
								"$ref": "angular-momentum-transfer.json"
							}
						}
					}
				},
				"comments": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"columns": {
								"type": "object",
								"propertyNames": {
									"enum": [
										"energy",
										"spinParity",
										"halfLife",
										"angularMomentumTransfer"
									]
								}
							}
						}
					}
				}
			}
		},
		"gammasTable": {
			"$ref": "gammas-table.json"
		}
	}
}
